<Window x:Class="NetSwitch.App.LogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetSwitch 日志"
        Height="500" Width="740"
        MinHeight="300" MinWidth="480"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,10">
            <TextBlock Text="运行日志" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
            <Button Content="刷新" Click="RefreshButton_Click" Padding="14,4" Margin="16,0,0,0"/>
            <Button Content="清空日志" Click="ClearButton_Click" Padding="14,4" Margin="8,0,0,0"/>
        </StackPanel>

        <TextBox Grid.Row="1" x:Name="LogTextBox" Margin="12,0,12,12"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"/>
    </Grid>
</Window>
